# Copier ce fichier vers .env, puis remplacer le mot de passe aux deux endroits.
POSTGRES_USER=handle_it
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=handle_it
DATABASE_URL=postgresql://handle_it:a-remplacer@localhost:5433/handle_it
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Facultatif : tentatives de connexion par IP et par quart d’heure (10 par défaut).
# AUTH_ATTEMPTS_LIMIT=10
