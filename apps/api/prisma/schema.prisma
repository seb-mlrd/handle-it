generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions     Session[]
  memberships  Membership[]
  activities   Activity[]

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum BoardRole {
  owner
  member

  @@map("board_role")
}

model Board {
  id          String       @id @db.Uuid
  name        String
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships Membership[]
  columns     Column[]
  invitations Invitation[]
  activities  Activity[]

  @@map("boards")
}

model Membership {
  boardId String    @map("board_id") @db.Uuid
  userId  String    @map("user_id") @db.Uuid
  role    BoardRole
  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
  @@map("memberships")
}

model Column {
  id      String @id @db.Uuid
  boardId String @map("board_id") @db.Uuid
  name    String
  rank    String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   Card[]

  @@unique([boardId, rank])
  @@map("columns")
}

model Card {
  id          String @id @db.Uuid
  columnId    String @map("column_id") @db.Uuid
  title       String
  description String
  rank        String
  column      Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([columnId, rank])
  @@map("cards")
}

model Invitation {
  id        String   @id @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([expiresAt])
  @@map("invitations")
}

/// Une entrée par modification réussie ; la carte n'a pas de clé étrangère pour survivre à sa suppression.
model Activity {
  id        String   @id @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  cardId    String?  @map("card_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  details   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([cardId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("activities")
}
